# Copy this file to .env once, then fill in the real LLM key.
HTTP_ADDR=:8080
MYSQL_DSN=root:root@tcp(127.0.0.1:3306)/packaging_ai?parseTime=true&charset=utf8mb4&loc=Local
MYSQL_MAX_OPEN_CONNS=20
MYSQL_MAX_IDLE_CONNS=10
MYSQL_CONN_MAX_LIFETIME_MIN=30
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_QUEUE=packaging-ai
REDIS_CONCURRENCY=4
LLM_BASE_URL=https://ai.zhisales.com/v1
LLM_API_KEY=replace-with-real-api-key
LLM_MODEL=gpt-6.1-sol
IMAGE_BASE_URL=https://ai.zhisales.com/v1
IMAGE_API_KEY=replace-with-real-api-key
IMAGE_MODEL=gpt-image-1.5
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TTL_HOURS=24
